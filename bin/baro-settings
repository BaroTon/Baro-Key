    def _quick_stats_card(self) -> Gtk.Widget:
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        card.add_css_class("card")
        card.add_css_class("stats")
        card.add_css_class("hoverable")
        card.set_size_request(-1, 144)
        card.set_hexpand(True)

        heading = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        heading.append(icon("power-profile-performance-symbolic", 18))
        heading.append(label("Thống kê nhanh", "card-heading"))
        heading.set_margin_bottom(16)
        card.append(heading)

        self.quick_text = label("Tùy chọn chưa được bật.", "quick-text", wrap=True)
        self.quick_text.set_margin_top(8)
        card.append(self.quick_text)
        return card

    def _small_status_card(
        self,
        icon_name: str,
        caption: str,
        attr: str,
        value: str,
    ) -> Gtk.Widget:
        card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        card.add_css_class("card")
        card.add_css_class("small")
        card.add_css_class("hoverable")
        card.set_hexpand(True)

        tile = Gtk.Box()
        tile.add_css_class("icon-tile")
        tile.set_size_request(40, 40)
        tile.set_halign(Gtk.Align.START)
        tile.set_valign(Gtk.Align.CENTER)
        tile.append(icon(icon_name, 18))
        card.append(tile)

        labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        labels.append(label(caption, "card-label"))
        value_label = label(value, "card-value")
        setattr(self, attr, value_label)
        labels.append(value_label)
        card.append(labels)
        return card

    def _shortcut_group(self, title: str, caps: Gtk.Widget) -> Gtk.Box:
        group = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        group.add_css_class("shortcut-group")
        group.append(label(title, "shortcut-label"))
        group.append(caps)
        return group

    # ---------------------------------------------------------------- method
    def _build_method_page(self) -> Gtk.Widget:
        page = self._new_page()
        page.append(
            self._page_header(
                "input-keyboard-symbolic",
                "Kiểu gõ",
                "Chọn kiểu gõ phù hợp với thói quen của bạn",
            )
        )

        methods = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        telex_right = Gtk.Box()
        add_key_grid(
            telex_right,
            (
                ("s", "d", "f", "g", "h", "j", "k", "l"),
                ("a", "o", "e", "u", "i"),
            ),
        )
        telex_card, *_ = radio_card(
            "Telex",
            'Gõ theo kiểu Telex (phổ biến, dễ nhớ). Ví dụ: hoa s -> hóa',
            active=self.config["method"] == "telex",
            right=telex_right,
        )
        telex_card.connect("clicked", self._on_method_clicked, "telex")
        self._method_cards["telex"] = telex_card
        methods.append(telex_card)

        vni_right = Gtk.Box()
        add_key_grid(vni_right, (tuple("1234567890"),))
        vni_card, *_ = radio_card(
            "VNI",
            'Gõ theo kiểu VNI (quen thuộc với người dùng cũ). Ví dụ: hoa 1 -> hóa',
            active=self.config["method"] == "vni",
            right=vni_right,
        )
        vni_card.connect("clicked", self._on_method_clicked, "vni")
        self._method_cards["vni"] = vni_card
        methods.append(vni_card)
        page.append(methods)

        tone_heading = self._section_heading("Kiểu đặt dấu")
        tone_heading.set_margin_top(24)
        tone_heading.set_margin_bottom(16)
        page.append(tone_heading)

        tone_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        modern, *_ = radio_card(
            "Kiểu mới",
            "Vị trí dấu hiện đại: hoà, thuỷ",
            active=self.config["tone_style"] == "modern",
        )
        modern.set_hexpand(True)
        modern.connect("clicked", self._on_tone_clicked, "modern")
        self._tone_cards["modern"] = modern
        tone_row.append(modern)

        old, *_ = radio_card(
            "Kiểu cũ",
            "Vị trí dấu truyền thống: hòa, thủy",
            active=self.config["tone_style"] == "old",
        )
        old.set_hexpand(True)
        old.connect("clicked", self._on_tone_clicked, "old")
        self._tone_cards["old"] = old
        tone_row.append(old)
        page.append(tone_row)

        page.append(spacer())
        banner = info_banner(
            "Bạn có thể thay đổi kiểu gõ bất cứ lúc nào. Các ứng dụng đang mở sẽ áp dụng ngay."
        )
        banner.set_margin_top(24)
        page.append(banner)
        return page

