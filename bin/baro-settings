        self.auto_restore_switch = make_switch()
        options.append(
            option_card(
                "Khôi phục phím tiếng Anh",
                "Giữ nguyên phím khi gõ tiếng Anh",
                self.auto_restore_switch,
            )
        )

        page.append(options)
        return page

    # ------------------------------------------------------------- shortcuts
    def _build_shortcuts_page(self) -> Gtk.Widget:
        page = self._new_page()
        page.append(
            self._page_header(
                "preferences-desktop-keyboard-symbolic",
                "Phím tắt",
                "Thiết lập phím tắt nhanh cho BaroKey",
            )
        )

        rows = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)

        for key, title, icon_name, presets in (
            (
                "shortcut_toggle",
                "Chuyển đổi Việt / Anh",
                "input-keyboard-symbolic",
                SHORTCUT_PRESETS["toggle"],
            ),
            (
                "shortcut_enable",
                "Bật / Tắt bộ gõ",
                "power-profile-performance-symbolic",
                SHORTCUT_PRESETS["enable"],
            ),
        ):
            card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
            card.add_css_class("card")
            card.add_css_class("option-card")
            card.set_hexpand(True)

            tile = Gtk.Box()
            tile.add_css_class("icon-tile")
            tile.set_size_request(40, 40)
            tile.set_valign(Gtk.Align.CENTER)
            tile.append(icon(icon_name, 18))
            card.append(tile)

            title_label = label(title, "option-title")
            title_label.set_hexpand(True)
            title_label.set_valign(Gtk.Align.CENTER)
            card.append(title_label)

            caps_box = Gtk.Box()
            caps_box.set_valign(Gtk.Align.CENTER)
            self._shortcut_caps[key] = caps_box
            fill_keycaps(caps_box, self.config[key], large=True)
            card.append(caps_box)

            button = Gtk.Button(label="Thay đổi")
            button.add_css_class("primary")
            button.set_valign(Gtk.Align.CENTER)
            button.connect("clicked", self._edit_shortcut, key, title, presets)
            card.append(button)
            rows.append(card)

        # The design also lists a settings shortcut; BaroKey has no global
        # accelerator for it yet, so the row is marked instead of pretending.
        settings_card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        settings_card.add_css_class("card")
        settings_card.add_css_class("option-card")
        settings_card.set_hexpand(True)
        settings_tile = Gtk.Box()
        settings_tile.add_css_class("icon-tile")
        settings_tile.set_size_request(40, 40)
        settings_tile.set_valign(Gtk.Align.CENTER)
        settings_tile.append(icon("preferences-system-symbolic", 18))
        settings_card.append(settings_tile)
        settings_title = label("Mở cài đặt", "option-title")
        settings_title.set_hexpand(True)
        settings_title.set_valign(Gtk.Align.CENTER)
        settings_card.append(settings_title)
        settings_keys = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        settings_keys.set_valign(Gtk.Align.CENTER)
        for index, key in enumerate(("Ctrl", ",")):
            if index:
                settings_keys.append(label("+", "key-plus"))
            settings_keys.append(keycap(key, large=True))
        settings_card.append(settings_keys)
        settings_card.append(label("Chưa hỗ trợ", "badge"))
        rows.append(settings_card)

        page.append(rows)
        page.append(spacer())
        banner = info_banner(
            "Bấm Thay đổi rồi nhấn tổ hợp phím bạn muốn. Một số phím tắt có thể bị xung đột "
            "với ứng dụng khác (ví dụ Ctrl + Shift + V là phím dán trong terminal). "
            "Chuyển nguồn nhập bằng Super + Space do IBus quản lý."
        )
        banner.set_margin_top(24)
        page.append(banner)
        return page

    # ------------------------------------------------------------ appearance
    def _build_appearance_page(self) -> Gtk.Widget:
        page = self._new_page()
        page.append(
            self._page_header(
                "applications-graphics-symbolic",
                "Giao diện",
                "Tùy chỉnh giao diện của BaroKey",
            )
        )

        style_heading = self._section_heading("Phong cách")
        style_heading.set_margin_bottom(16)
        page.append(style_heading)

        style_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        for value, title, description in UI_STYLES:
            card, *_ = radio_card(
                title, description, active=self.config.get("ui_style") == value
            )
            card.set_hexpand(True)
            card.connect("clicked", self._on_style_clicked, value)
            self._style_cards[value] = card
            style_row.append(card)
        page.append(style_row)

        theme_heading = self._section_heading("Chủ đề")
        theme_heading.set_margin_top(32)
        theme_heading.set_margin_bottom(16)
        page.append(theme_heading)

        theme_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=20)
        theme_row.set_hexpand(True)
        for value, title, icon_name, variant in (
            ("light", "Sáng", "weather-clear-symbolic", "light"),
            ("dark", "Tối", "weather-clear-night-symbolic", "dark"),
            ("auto", "Tự động", "video-display-symbolic", "auto"),
        ):
            button = self._theme_button(title, icon_name, variant)
            button.connect("clicked", self._on_theme_clicked, value)
            self._theme_cards[value] = button
            theme_row.append(button)
        page.append(theme_row)

        display_heading = self._section_heading("Kiểu hiển thị", "Chưa hỗ trợ")
        display_heading.set_margin_top(32)
        display_heading.set_margin_bottom(16)
        page.append(display_heading)

        display_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        full, *_ = radio_card("Biểu tượng đầy đủ", active=True, enabled=False)
        full.set_hexpand(True)
        compact, *_ = radio_card("Chỉ biểu tượng (nhỏ gọn)", enabled=False)
        compact.set_hexpand(True)
        display_row.append(full)
        display_row.append(compact)
        page.append(display_row)

        notif_heading = self._section_heading("Thông báo")
        notif_heading.set_margin_top(32)
        notif_heading.set_margin_bottom(16)
        page.append(notif_heading)

        self.notifications_switch = make_switch()
        page.append(
            option_card(
                "Thông báo khi chuyển chế độ",
                "Hiện thông báo khi bật/tắt bộ gõ hoặc chuyển Việt / Anh",
                self.notifications_switch,
            )
        )

        page.append(spacer())
        banner = info_banner(
            "Giao diện sẽ được áp dụng ngay lập tức cho toàn bộ ứng dụng. "
            "Chế độ Tự động đi theo cài đặt sáng/tối của GNOME."
        )
        banner.set_margin_top(24)
        page.append(banner)
        return page

    def _theme_button(self, title: str, icon_name: str, variant: str) -> Gtk.Button:
        button = Gtk.Button()
        button.add_css_class("theme-card")
        button.set_hexpand(True)

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)

        preview = Gtk.Box()
        preview.add_css_class("theme-preview")
        preview.add_css_class(variant)
        preview.set_size_request(-1, 112)

        mini = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        mini.add_css_class("mini-window")
        mini.add_css_class("light" if variant == "light" else "dark")
        mini.set_size_request(-1, 64)
        mini.set_valign(Gtk.Align.CENTER)
        mini.set_margin_start(12)
        mini.set_margin_end(12)

        sidebar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        sidebar.add_css_class("mini-sidebar")
        sidebar.add_css_class("light" if variant == "light" else "dark")
        sidebar.set_size_request(58, -1)
        sidebar.set_margin_top(8)
        sidebar.set_margin_bottom(8)
        sidebar.set_margin_start(8)
        line = Gtk.Box()
        line.add_css_class("mini-line")
        line.add_css_class("light" if variant == "light" else "dark")
        line.set_size_request(38, 4)
        sidebar.append(line)
        line2 = Gtk.Box()
        line2.add_css_class("mini-line")
        line2.add_css_class("light" if variant == "light" else "dark")
        line2.set_size_request(26, 4)
        sidebar.append(line2)
        mini.append(sidebar)

        mini_body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        mini_body.set_margin_top(8)
        mini_body.set_margin_bottom(8)
        mini_body.set_margin_start(8)
        mini_body.set_margin_end(8)
        mini_body.set_hexpand(True)
        blue = Gtk.Box()
        blue.add_css_class("mini-line")
        blue.add_css_class("blue")
        blue.set_size_request(54, 6)
        mini_body.append(blue)
        block = Gtk.Box()
        block.add_css_class("mini-line")
        block.add_css_class("light" if variant == "light" else "dark")
        block.set_size_request(-1, 18)
        mini_body.append(block)
        mini.append(mini_body)
        preview.append(mini)
        content.append(preview)

        caption = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        caption.set_halign(Gtk.Align.CENTER)
        caption.set_margin_top(12)
        caption.append(icon(icon_name, 16, None))
        caption.append(label(title, "theme-label"))
        content.append(caption)

        button.set_child(content)
        return button

    # ----------------------------------------------------------------- about
    def _build_about_page(self) -> Gtk.Widget:
        page = self._new_page()
        page.append(
            self._page_header(
                "help-about-symbolic",
                "Thông tin",
                "Phiên bản và thông tin ứng dụng",
            )
        )

        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        card.add_css_class("card")
        card.add_css_class("about-card")
        card.set_halign(Gtk.Align.FILL)

        logo = logo_image(96)
        logo.set_halign(Gtk.Align.CENTER)
        logo.set_margin_bottom(24)
        card.append(logo)

        name = label(APP_NAME, "about-name", xalign=0.5)
        name.set_halign(Gtk.Align.CENTER)
        name.set_margin_bottom(8)
        card.append(name)

        version = label(f"Phiên bản {__version__}", "about-version", xalign=0.5)
        version.set_halign(Gtk.Align.CENTER)
        version.set_margin_bottom(16)
        card.append(version)

        description = label(
            "Bộ gõ tiếng Việt dễ dàng hơn trên Linux. Hỗ trợ đa dạng bảng mã, "
            "kiểu gõ và tối ưu hóa trải nghiệm người dùng với giao diện hiện đại.",
            "about-desc",
            wrap=True,
            xalign=0.5,
            justify_center=True,
        )
        description.set_max_width_chars(58)
        description.set_halign(Gtk.Align.CENTER)
        description.set_margin_bottom(32)
        card.append(description)

        links = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
        links.set_halign(Gtk.Align.CENTER)
        for text, icon_name, callback, value in (
            ("GitHub", "insert-link-symbolic", self._open_uri, SITE_URL),
            ("Trang chủ", "go-home-symbolic", self._open_uri, SITE_URL),
            ("Đóng góp", "system-users-symbolic", self._open_donate, None),
        ):
            button = Gtk.Button()
            button.add_css_class("about-link")
            child = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            child.append(icon(icon_name, 18, None))
            child.append(label(text))
            button.set_child(child)
            if value is None:
                button.connect("clicked", callback)
            else:
                button.connect("clicked", callback, value)
            links.append(button)
        card.append(links)
        page.append(card)

        page.append(spacer())
        copyright_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        copyright_box.set_halign(Gtk.Align.CENTER)
        copyright_box.set_margin_top(24)
        copyright_box.append(label("Thông tin bản quyền", "copyright", xalign=0.5))
        copyright_box.append(
            label(
                f"© 2026 {APP_NAME}. Phát triển bởi cộng đồng nguồn mở.",
                "copyright-small",
                xalign=0.5,
            )
        )
        page.append(copyright_box)
        return page

    # ---------------------------------------------------------------- state
    def _build_state_bindings(self) -> None:
        self.status_switch.connect("notify::active", self._on_status_changed)
        self.free_marking_switch.connect("notify::active", self._on_free_marking_changed)
        self.auto_restore_switch.connect("notify::active", self._on_auto_restore_changed)
        self.notifications_switch.connect(
            "notify::active", self._on_notifications_changed
        )

    def _sync_widgets(self) -> None:
        self._loading = True
        cfg = self.config
        self.status_switch.set_active(bool(cfg["start_enabled"]))
        self.free_marking_switch.set_active(bool(cfg["free_marking"]))
        self.auto_restore_switch.set_active(bool(cfg["auto_restore"]))
        self.notifications_switch.set_active(bool(cfg.get("notifications", True)))
        self.go_tat_switch.set_active(False)
        self.spell_check_switch.set_active(False)
        self._sync_method()
        self._sync_tone()
        self._sync_theme()
        self._sync_style()
        self._refresh_status()
        self._refresh_quick_stats()
        self._refresh_shortcut_labels()
        self._loading = False

    def _sync_method(self) -> None:
        for value, card in self._method_cards.items():
            set_radio_active(card, value == self.config["method"])

    def _sync_tone(self) -> None:
        for value, card in self._tone_cards.items():
            set_radio_active(card, value == self.config["tone_style"])

    def _sync_theme(self) -> None:
        for value, card in self._theme_cards.items():
            if value == self.config["theme"]:
                card.add_css_class("selected")
            else:
                card.remove_css_class("selected")

    def _sync_style(self) -> None:
        for value, card in self._style_cards.items():
            set_radio_active(card, value == self.config.get("ui_style"))

    def _refresh_status(self) -> None:
        enabled = bool(self.config["start_enabled"])
        vietnamese = not bool(self.config["english_mode"])
        if enabled:
            self.status_dot.remove_css_class("off")
            self.big_status.set_text("Đang hoạt động")
            self.stat_bar.remove_css_class("off")
            if vietnamese:
                self.stats_value.set_text("Đang gõ tiếng Việt")
                self.stats_value.remove_css_class("card-value-blue")
                self.stats_value.remove_css_class("card-value-off")
                self.stats_value.add_css_class("card-value-green")
            else:
                self.stats_value.set_text("Đang gõ tiếng Anh")
                self.stats_value.remove_css_class("card-value-green")
                self.stats_value.remove_css_class("card-value-off")
                self.stats_value.add_css_class("card-value-blue")
        else:
            self.status_dot.add_css_class("off")
            self.big_status.set_text("Đã tắt")
            self.stat_bar.add_css_class("off")
            self.stats_value.set_text("Đã tắt")
            self.stats_value.remove_css_class("card-value-green")
            self.stats_value.remove_css_class("card-value-blue")
            self.stats_value.add_css_class("card-value-off")
        self.method_value.set_text("VNI" if self.config["method"] == "vni" else "Telex")
        self.charset_value.set_text("Unicode")

    def _refresh_quick_stats(self) -> None:
        active = []
        if self.config.get("free_marking", True):
            active.append("Bỏ dấu tự do")
        if self.config.get("auto_restore", True):
            active.append("Khôi phục tiếng Anh")
        if self.config.get("notifications", True):
            active.append("Thông báo")
        if not active:
            self.quick_text.set_text("Tùy chọn chưa được bật.")
        else:
            self.quick_text.set_text("Đang bật: " + " · ".join(active))

    def _refresh_shortcut_labels(self) -> None:
        for key, caps in self._shortcut_caps.items():
            fill_keycaps(caps, self.config[key], large=True)
        for key, caps in self._overview_shortcut_caps.items():
            fill_keycaps(caps, self.config[key])

    def _save(self, message: str | None = None) -> None:
        # The IBus engine also writes this file (english_mode, start_enabled), so
        # write only what changed here instead of our whole, possibly stale, copy.
        merged = config.apply_changes(config.load(), self.config, self._synced)
        config.save(merged)
        self.config = merged
        self._synced = dict(merged)
        self._refresh_quick_stats()
        if message:
            self._show_toast(message)

    def _reload_from_disk(self) -> None:
        """Pick up changes made by the engine, e.g. a Việt / Anh toggle."""
        fresh = config.load()
        if fresh == self.config and fresh == self._synced:
            return
        self.config = fresh
        self._synced = dict(fresh)
        self._sync_widgets()

    def _on_active_changed(self, window, _pspec) -> None:
        if window.is_active():
            self._reload_from_disk()

    def _show_toast(self, message: str) -> None:
        self.toast_label.set_text(message)
        self.toast.set_visible(True)
        if self._toast_timer is not None:
            GLib.source_remove(self._toast_timer)
        self._toast_timer = GLib.timeout_add(1900, self._hide_toast)

    def _hide_toast(self) -> bool:
        self.toast.set_visible(False)
        self._toast_timer = None
        return False

    # ------------------------------------------------------------- callbacks
    def _on_nav_clicked(self, _button: Gtk.Button, name: str) -> None:
        self._show_page(name)

    def _show_page(self, name: str) -> None:
        if name not in self._pages:
            return
        self.stack.set_visible_child_name(name)
        self.center_title.set_text(
            next((text for key, text, _icon in NAV_ITEMS if key == name), "")
        )
        for key, button in self._nav_buttons.items():
            if key == name:
                button.add_css_class("current")
            else:
                button.remove_css_class("current")

    def _on_status_changed(self, switch: Gtk.Switch, _pspec=None) -> None:
        if self._loading:
            return
        active = bool(switch.get_active())
        self.config["start_enabled"] = active
        if not active:
            self.config["english_mode"] = False
        self._refresh_status()
        self._save("Đã bật bộ gõ tiếng Việt" if active else "Đã tắt bộ gõ tiếng Việt")
        if self.config.get("notifications", True):
            if active:
                notify.send(
                    "Đã bật bộ gõ tiếng Việt",
                    "BaroKey đã sẵn sàng hoạt động.",
                )
            else:
                notify.send(
                    "Đã tắt bộ gõ tiếng Việt",
                    f"Nhấn {notify.shortcut_label(self.config['shortcut_enable'])} "
                    "để bật lại.",
                )

    def _on_method_clicked(self, _button: Gtk.Button, value: str) -> None:
        if self._loading:
            return
        self.config["method"] = value
        self._sync_method()
        self._refresh_status()
        self._save("Đã đổi kiểu gõ")

    def _on_tone_clicked(self, _button: Gtk.Button, value: str) -> None:
        if self._loading:
            return
        self.config["tone_style"] = value
        self._sync_tone()
        self._save("Đã đổi kiểu đặt dấu")

    def _on_charset_clicked(self, _button: Gtk.Button, _value: str) -> None:
        if self._loading:
            return
        set_radio_active(self.charset_card, True)
        self._save("BaroKey đang dùng bảng mã Unicode")

    def _on_free_marking_changed(self, switch: Gtk.Switch, _pspec=None) -> None:
        if self._loading:
            return
        self.config["free_marking"] = bool(switch.get_active())
        self._save("Đã cập nhật tùy chọn bỏ dấu tự do")

    def _on_auto_restore_changed(self, switch: Gtk.Switch, _pspec=None) -> None:
        if self._loading:
            return
        self.config["auto_restore"] = bool(switch.get_active())
        self._save("Đã cập nhật khôi phục phím tiếng Anh")

    def _on_notifications_changed(self, switch: Gtk.Switch, _pspec=None) -> None:
        if self._loading:
            return
        self.config["notifications"] = bool(switch.get_active())
        self._save("Đã cập nhật thông báo")

    def _edit_shortcut(self, _button, key: str, title: str, presets) -> None:
        other_key = "shortcut_enable" if key == "shortcut_toggle" else "shortcut_toggle"
        other_title = (
            "Bật / Tắt bộ gõ" if other_key == "shortcut_enable" else "Chuyển đổi Việt / Anh"
        )
        dialog = ShortcutDialog(
            self,
            title,
            presets,
            self.config.get(key, presets[0][0]),
            config.DEFAULTS[key],
            self.config.get(other_key, config.DEFAULTS[other_key]),
            other_title,
            lambda spec: self._set_shortcut(key, spec),
        )
        dialog.present()

    def _set_shortcut(self, key: str, spec: str) -> None:
        self.config[key] = spec
        self._refresh_shortcut_labels()
        self._save("Đã cập nhật phím tắt")

    def _on_theme_clicked(self, _button, theme: str) -> None:
        self.config["theme"] = theme
        self._sync_theme()
        self.app.apply_theme(theme)
        self._save("Đã đổi giao diện")

    def _on_style_clicked(self, _button, value: str) -> None:
        if self._loading:
            return
        self.config["ui_style"] = value
        self._sync_style()
        self.app.ui_style = value
        self.app.apply_theme(self.config["theme"])
        self.apply_style_class()
        self._save("Đã đổi phong cách giao diện")

    def _open_uri(self, _button, uri: str) -> None:
        Gtk.show_uri(self, uri, Gdk.CURRENT_TIME)

    def _open_donate(self, _button) -> None:
        DonateDialog(self).present()


class BaroKeyApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)
        self.window = None
        self.ui_style = "default"
        self.css_provider = Gtk.CssProvider()
        self._css_added = False
        self._interface_settings = None
        self._applying = False

    def do_startup(self):
        Gtk.Application.do_startup(self)
        GLib.set_application_name(APP_NAME)
        GLib.set_prgname(APP_ID)
        Gtk.Window.set_default_icon_name("barokey")
        saved = config.load()
        self.ui_style = saved.get("ui_style", "default")
        self.apply_theme(saved.get("theme", "dark"))
        try:
            self._interface_settings = Gio.Settings.new("org.gnome.desktop.interface")
            self._interface_settings.connect(
                "changed::color-scheme", self._on_system_theme_changed
            )
        except Exception:
            self._interface_settings = None
        gtk_settings = Gtk.Settings.get_default()
        if gtk_settings is not None:
            gtk_settings.connect(
                "notify::gtk-application-prefer-dark-theme",
                self._on_system_theme_changed,
            )

    def _on_system_theme_changed(self, *_args):
        if self.window is not None and self.window.config.get("theme") == "auto":
            self.apply_theme("auto")

    def apply_theme(self, theme: str) -> None:
        if self._applying:
            return
        self._applying = True
        resolved = theme
        if theme not in {"light", "dark"}:
            resolved = "dark" if prefers_dark() else "light"
        palette = DARK if resolved == "dark" else LIGHT
        gtk_settings = Gtk.Settings.get_default()
        if gtk_settings is not None:
            gtk_settings.props.gtk_application_prefer_dark_theme = resolved == "dark"
        try:
            css = CSS.substitute(**palette)
            if self.ui_style == "tahoe":
                extra = TAHOE_DARK if resolved == "dark" else TAHOE_LIGHT
                css += TAHOE_CSS.substitute(**palette, **extra)
            self.css_provider.load_from_data(css.encode("utf-8"))
        except GLib.Error as error:
            print(f"BaroKey: CSS error: {error}", file=sys.stderr)
        display = Gdk.Display.get_default()
        if display is not None and not self._css_added:
            # BaroKey has its own visual language.  Use a priority above the
            # user's gtk.css so classes such as "sidebar", "card" and
            # "keycap" do not get repainted by a desktop theme (Adwaita,
            # Yaru, MacTahoe, ...) and break the layout.
            Gtk.StyleContext.add_provider_for_display(
                display,
                self.css_provider,
                Gtk.STYLE_PROVIDER_PRIORITY_USER + 1,
            )
            self._css_added = True
        self._applying = False

    def do_activate(self):
        if self.window is None:
            self.window = SettingsWindow(self)
        self.window.present()


def main() -> None:
    notify.APP_NAME = APP_NAME
    BaroKeyApp().run(sys.argv)


if __name__ == "__main__":
    main()
