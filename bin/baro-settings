def asset_path(name: str) -> str:
    for base in (
        os.path.join(BASE_DIR, "desktop"),
        os.path.join(BASE_DIR, "share"),
        os.path.join(BASE_DIR, "data"),
    ):
        path = os.path.join(base, name)
        if os.path.exists(path):
            return path
    return ""


def logo_image(size: int) -> Gtk.Widget:
    # The wordmark is unreadable below ~48 px, so small logos drop it.
    path = asset_path("barokey-notext.png" if size <= 48 else "barokey.png") or asset_path(
        "barokey.png"
    )
    if path:
        image = Gtk.Image.new_from_file(path)
        image.set_pixel_size(size)
        return image
    image = Gtk.Image.new_from_icon_name("input-keyboard-symbolic")
    image.set_pixel_size(size)
    return image


def donate_qr_image(size: int = 220) -> Gtk.Widget:
    path = asset_path("barokey-donate-qr.png")
    if path:
        image = Gtk.Image.new_from_file(path)
        image.set_pixel_size(size)
        return image
    image = Gtk.Image.new_from_icon_name("dialog-information-symbolic")
    image.set_pixel_size(size)
    return image


def icon(name: str, size: int = 18, css: str | None = "tile-icon") -> Gtk.Image:
    image = Gtk.Image.new_from_icon_name(name)
    image.set_pixel_size(size)
    image.set_valign(Gtk.Align.CENTER)
    if css:
        image.add_css_class(css)
    return image


def label(
    text: str,
    css: str | None = None,
    *,
    wrap: bool = False,
    xalign: float = 0.0,
    justify_center: bool = False,
    selectable: bool = False,
) -> Gtk.Label:
    widget = Gtk.Label(label=text)
    widget.set_xalign(xalign)
    widget.set_wrap(wrap)
    if justify_center:
        widget.set_justify(Gtk.Justification.CENTER)
    if selectable:
        widget.set_selectable(True)
    if css:
        widget.add_css_class(css)
    return widget


def spacer() -> Gtk.Box:
    box = Gtk.Box()
    box.set_hexpand(True)
    box.set_vexpand(True)
    return box


def separator() -> Gtk.Separator:
    sep = Gtk.Separator(orientation=Gtk.Orientation.HORIZONTAL)
    sep.set_margin_top(12)
    sep.set_margin_bottom(12)
    return sep


def shortcut_parts(spec: str) -> list[str]:
    return [part.strip() for part in notify.shortcut_label(spec).split("+")]


def keycap(text: str, large: bool = False) -> Gtk.Widget:
    box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
    box.add_css_class("keycap")
    if large:
        box.add_css_class("large")
    box.append(label(text, "keycap"))
    return box


def key_tile(text: str) -> Gtk.Widget:
    box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
    box.add_css_class("key-tile")
    box.set_halign(Gtk.Align.CENTER)
    box.set_valign(Gtk.Align.CENTER)
    box.append(label(text, "key-tile"))
    return box


def keycaps_row(spec: str, large: bool = False) -> Gtk.Box:
    row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6 if large else 4)
    parts = shortcut_parts(spec)
    for index, part in enumerate(parts):
        if index:
            row.append(label("+", "key-plus"))
        row.append(keycap(part, large))
    return row


def fill_keycaps(container: Gtk.Box, spec: str, large: bool = False) -> None:
    for child in list(container):
        container.remove(child)
    row = keycaps_row(spec, large)
    container.append(row)


def make_titlebar(title_widget: Gtk.Widget) -> Gtk.Widget:
    handle = Gtk.WindowHandle()
    handle.add_css_class("titlebar")
    bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    bar.add_css_class("titlebar-inner")
    bar.set_margin_start(16)
    bar.set_margin_end(8)
    lights = Gtk.WindowControls(side=Gtk.PackType.START)
    lights.set_decoration_layout("close,minimize,maximize:")
    lights.add_css_class("trafficlights")
    lights.set_valign(Gtk.Align.CENTER)
    lights.set_visible(False)
    bar.append(lights)
    title_widget.set_valign(Gtk.Align.CENTER)
    bar.append(title_widget)
    expand = Gtk.Box()
    expand.set_hexpand(True)
    bar.append(expand)
    controls = Gtk.WindowControls(side=Gtk.PackType.END)
    controls.set_decoration_layout(":minimize,maximize,close")
    controls.set_valign(Gtk.Align.CENTER)
    bar.append(controls)
    handle.set_child(bar)
    handle.baro_lights = lights  # type: ignore[attr-defined]
    handle.baro_controls = controls  # type: ignore[attr-defined]
    return handle


def radio_card(
    title: str,
    description: str = "",
    *,
    active: bool = False,
    enabled: bool = True,
    right: Gtk.Widget | None = None,
    badge: str | None = None,
) -> tuple[Gtk.Button, Gtk.Box, Gtk.Box]:
    button = Gtk.Button()
    button.add_css_class("radio-card")
    button.set_sensitive(enabled)

    content = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
    content.set_hexpand(True)

    ring = Gtk.Box()
    ring.add_css_class("radio-ring")
    ring.set_halign(Gtk.Align.CENTER)
    ring.set_valign(Gtk.Align.START)
    ring.set_margin_top(2)
    dot = Gtk.Box()
    dot.add_css_class("radio-dot")
    dot.set_halign(Gtk.Align.CENTER)
    dot.set_valign(Gtk.Align.CENTER)
    dot.set_visible(active)
    ring.append(dot)
    content.append(ring)

    labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
    labels.set_hexpand(True)
    title_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    title_row.append(label(title, "radio-title"))
    if badge:
        title_row.append(label(badge, "badge"))
    labels.append(title_row)
    if description:
        labels.append(label(description, "radio-desc", wrap=True))
    content.append(labels)

    if right is not None:
        right.set_valign(Gtk.Align.CENTER)
        content.append(right)

    button.set_child(content)
    button.baro_active = active  # type: ignore[attr-defined]
    button.baro_dot = dot  # type: ignore[attr-defined]
    if active:
        button.add_css_class("selected")
    return button, button, dot


def set_radio_active(button: Gtk.Button, active: bool) -> None:
    button.baro_active = active  # type: ignore[attr-defined]
    dot = getattr(button, "baro_dot", None)
    if dot is not None:
        dot.set_visible(active)
    if active:
        button.add_css_class("selected")
    else:
        button.remove_css_class("selected")


def make_switch() -> Gtk.Switch:
    """A Gtk.Switch without its internal on/off marks.

    GTK 4.22 builds a 16 px GtkImage for each mark and then warns
    "reported baselines of minimum -2147483648 ..." for every one on first
    layout. BaroKey never shows the marks, so hide them.
    """
    switch = Gtk.Switch()
    child = switch.get_first_child()
    while child is not None:
        if isinstance(child, Gtk.Image):
            child.set_visible(False)
        child = child.get_next_sibling()
    return switch


def option_card(
    title: str,
    subtitle: str,
    switch: Gtk.Switch,
    *,
    badge: str | None = None,
) -> Gtk.Box:
    card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=16)
    card.add_css_class("card")
    card.add_css_class("option-card")
    card.set_hexpand(True)

    labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
    labels.set_hexpand(True)
    title_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
    title_row.append(label(title, "option-title"))
    if badge:
        title_row.append(label(badge, "badge"))
    labels.append(title_row)
    labels.append(label(subtitle, "option-sub", wrap=True))
    card.append(labels)
    switch.set_valign(Gtk.Align.CENTER)
    card.append(switch)
    return card


def info_banner(text: str) -> Gtk.Box:
    banner = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
    banner.add_css_class("card")
    banner.add_css_class("info-banner")
    banner.set_hexpand(True)
    banner_icon = icon("dialog-information-symbolic", 20, None)
    banner_icon.set_valign(Gtk.Align.START)
    banner_icon.set_margin_top(1)
    banner.append(banner_icon)
    banner.append(label(text, "info-text", wrap=True))
    return banner


def add_key_grid(container: Gtk.Box, rows: tuple[tuple[str, ...], ...]) -> None:
    holder = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
    holder.add_css_class("radio-right")
    for keys in rows:
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=4)
        for key in keys:
            row.append(key_tile(key))
        holder.append(row)
    container.append(holder)


def prefers_dark() -> bool:
    try:
        settings = Gio.Settings.new("org.gnome.desktop.interface")
        if settings.get_string("color-scheme") == "prefer-dark":
            return True
    except Exception:
        pass
    gtk_settings = Gtk.Settings.get_default()
    if gtk_settings is not None:
        if gtk_settings.props.gtk_application_prefer_dark_theme:
            return True
        name = (gtk_settings.props.gtk_theme_name or "").lower()
        if "dark" in name:
            return True
    return False


_MODIFIER_KEYVALS = {
    Gdk.KEY_Control_L, Gdk.KEY_Control_R, Gdk.KEY_Shift_L, Gdk.KEY_Shift_R,
    Gdk.KEY_Alt_L, Gdk.KEY_Alt_R, Gdk.KEY_Super_L, Gdk.KEY_Super_R,
    Gdk.KEY_Meta_L, Gdk.KEY_Meta_R, Gdk.KEY_Hyper_L, Gdk.KEY_Hyper_R,
    Gdk.KEY_Caps_Lock, Gdk.KEY_Num_Lock, Gdk.KEY_ISO_Level3_Shift,
}
_KEY_NAME_FIXES = {"iso_left_tab": "tab"}
# Modifier keys that can make up a modifier-only shortcut such as Alt + Shift.
_CHORD_NAMES = {
    Gdk.KEY_Control_L: "ctrl", Gdk.KEY_Control_R: "ctrl",
    Gdk.KEY_Alt_L: "alt", Gdk.KEY_Alt_R: "alt",
    Gdk.KEY_Meta_L: "alt", Gdk.KEY_Meta_R: "alt",
    Gdk.KEY_Shift_L: "shift", Gdk.KEY_Shift_R: "shift",
    Gdk.KEY_Super_L: "super", Gdk.KEY_Super_R: "super",
}


def spec_from_event(controller: Gtk.EventControllerKey, keyval: int, keycode: int,
                    state: Gdk.ModifierType) -> str | None:
    """Turn a key press into a spec like "ctrl+alt+k"; None for a bare modifier."""
    if keyval in _MODIFIER_KEYVALS:
        return None
    # The key itself, as if no modifier were held: Shift+1 is "1", not "exclam".
    base = keyval
    display = Gdk.Display.get_default()
    if display is not None:
        group = controller.get_group() if controller.get_current_event() else 0
        found, translated, *_rest = display.translate_key(
            keycode, Gdk.ModifierType(0), group
        )
        if found and translated:
            base = translated
    name = Gdk.keyval_name(Gdk.keyval_to_lower(base)) or ""
    name = _KEY_NAME_FIXES.get(name.lower(), name.lower())
    mods = []
    for flag, word in (
        (Gdk.ModifierType.CONTROL_MASK, "ctrl"),
        (Gdk.ModifierType.ALT_MASK, "alt"),
        (Gdk.ModifierType.SHIFT_MASK, "shift"),
        (Gdk.ModifierType.SUPER_MASK, "super"),
    ):
        if state & flag:
            mods.append(word)
    return "+".join(mods + [name])


class ShortcutDialog(Gtk.Window):
    """Press any key combination to assign it; presets are only suggestions."""

    def __init__(
        self,
        parent: Gtk.Window,
        title: str,
        presets,
        current: str,
        default: str,
        other: str,
        other_title: str,
        on_save,
    ):
        super().__init__(
            transient_for=parent,
            modal=True,
            title=title,
            default_width=500,
            default_height=420,
        )
        self.add_css_class("barokey")
        self._on_save = on_save
        self._default = default
        self._other = other
        self._other_title = other_title
        self._current = current
        self._chosen = current
        # Modifier-only shortcuts are decided when the keys are released.
        self._held: set[int] = set()
        self._peak: set[str] = set()
        self._dirty = False

        self.set_titlebar(make_titlebar(label(title, "dialog-title")))

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        content.set_margin_top(24)
        content.set_margin_bottom(24)
        content.set_margin_start(24)
        content.set_margin_end(24)
        self.set_child(content)

        content.append(
            label(
                "Nhấn tổ hợp phím bạn muốn dùng. Cần có Ctrl, Alt hoặc Super "
                "(riêng phím F1–F12 có thể dùng một mình). Hoặc giữ hai phím như "
                "Alt + Shift rồi nhả, giống EVKey.",
                "option-sub",
                wrap=True,
            )
        )

        self._capture = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self._capture.add_css_class("key-capture")
        self._capture_keys = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        self._capture_keys.set_halign(Gtk.Align.CENTER)
        self._capture.append(self._capture_keys)
        content.append(self._capture)

        self._message = label("", "capture-hint", wrap=True, xalign=0.5)
        self._message.set_halign(Gtk.Align.CENTER)
        content.append(self._message)

        content.append(label("Gợi ý", "section-heading"))
        suggestions = Gtk.FlowBox()
        suggestions.set_selection_mode(Gtk.SelectionMode.NONE)
        suggestions.set_homogeneous(False)
        suggestions.set_column_spacing(8)
        suggestions.set_row_spacing(8)
        suggestions.set_max_children_per_line(6)
        suggestions.set_halign(Gtk.Align.START)
        for spec, display in presets:
            button = Gtk.Button(label=display)
            button.add_css_class("ghost")
            button.connect("clicked", lambda _b, spec=spec: self._choose(spec))
            suggestions.append(button)
        content.append(suggestions)

        content.append(spacer())

        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        reset = Gtk.Button(label="Mặc định")
        reset.add_css_class("ghost")
        reset.connect("clicked", lambda *_: self._choose(self._default))
        actions.append(reset)
        actions.append(spacer())
        cancel = Gtk.Button(label="Hủy")
        cancel.add_css_class("ghost")
        cancel.connect("clicked", lambda *_: self.close())
        self._save_button = Gtk.Button(label="Lưu")
        self._save_button.add_css_class("primary")
        self._save_button.connect("clicked", self._save)
        actions.append(cancel)
        actions.append(self._save_button)
        content.append(actions)

        keys = Gtk.EventControllerKey()
        keys.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", self._on_key_pressed)
        keys.connect("key-released", self._on_key_released)
        self.add_controller(keys)
        self._keys = keys

        self._choose(current)

    def _choose(self, spec: str) -> None:
        self._chosen = spec
        fill_keycaps(self._capture_keys, spec, large=True)
        self._validate()

    def _validate(self) -> None:
        spec = self._chosen
        problem = None
        if not config.valid_shortcut(spec):
            problem = "Tổ hợp này không dùng được. Hãy thêm Ctrl, Alt hoặc Super."
        elif config.normalize_shortcut(spec) == config.normalize_shortcut(self._other):
            problem = f"Trùng với phím tắt “{self._other_title}”. Hãy chọn tổ hợp khác."
        if problem:
            self._message.set_text(problem)
            self._message.add_css_class("capture-error")
        else:
            self._message.set_text(
                "Đang dùng tổ hợp này." if spec == self._current else "Nhấn Lưu để áp dụng."
            )
            self._message.remove_css_class("capture-error")
        self._save_button.set_sensitive(problem is None)

    def _on_key_pressed(self, controller, keyval, keycode, state) -> bool:
        plain = not (
            state
            & (
                Gdk.ModifierType.CONTROL_MASK
                | Gdk.ModifierType.ALT_MASK
                | Gdk.ModifierType.SUPER_MASK
                | Gdk.ModifierType.SHIFT_MASK
            )
        )
        if keyval == Gdk.KEY_Escape and plain:
            self.close()
            return True
        name = _CHORD_NAMES.get(keyval)
        if name is not None:
            self._held.add(keyval)
            self._peak.add(name)
            return True
        if self._peak:
            self._dirty = True  # a normal key joined the modifiers: not a chord
        spec = spec_from_event(controller, keyval, keycode, state)
        if spec is not None:
            self._choose(spec)
        return True  # swallow everything: the keys are the input here

    def _on_key_released(self, _controller, keyval, _keycode, _state) -> None:
        if keyval not in self._held:
            return
        if not self._dirty and len(self._peak) >= 2:
            ordered = [m for m in ("ctrl", "alt", "shift", "super") if m in self._peak]
            self._choose("+".join(ordered))
            self._peak = set()  # fire once, even though several keys are released
        self._held.discard(keyval)
        if not self._held:
            self._peak = set()
            self._dirty = False

    def _save(self, _button: Gtk.Button) -> None:
        if not config.valid_shortcut(self._chosen):
            return
        self._on_save(config.normalize_shortcut(self._chosen))
        self.close()


class DonateDialog(Gtk.Window):
    """VietQR card used by the "Đóng góp" action in the About page."""

    def __init__(self, parent: Gtk.Window):
        super().__init__(
            transient_for=parent,
            modal=True,
            title="Ủng hộ BaroKey",
            default_width=460,
            default_height=650,
        )
        self.add_css_class("barokey")
        self.set_resizable(False)
        self._copy_timer = None
        self.set_titlebar(make_titlebar(label("Ủng hộ BaroKey", "dialog-title")))

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        content.set_margin_top(24)
        content.set_margin_bottom(24)
        content.set_margin_start(24)
        content.set_margin_end(24)
        self.set_child(content)

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        heart = label("♥", "donate-heart", xalign=0.5)
        heart.set_valign(Gtk.Align.CENTER)
        header.append(heart)
        header_text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        header_text.append(label("Ủng hộ BaroKey", "donate-title"))
        header_text.append(
            label(
                "Quét mã VietQR để gửi đóng góp cho dự án.",
                "donate-sub",
                wrap=True,
            )
        )
        header.append(header_text)
        content.append(header)

        qr_card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        qr_card.add_css_class("qr-card")
        qr_card.set_halign(Gtk.Align.CENTER)
        qr_card.append(donate_qr_image(220))
        content.append(qr_card)

        account = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        account.add_css_class("account-card")
        details = Gtk.Grid()
        details.set_row_spacing(6)
        details.set_column_spacing(24)
        details.attach(label("Ngân hàng", "account-label"), 0, 0, 1, 1)
        details.attach(label(DONATE_BANK, "account-value"), 1, 0, 1, 1)
        details.attach(label("Chủ tài khoản", "account-label"), 0, 1, 1, 1)
        details.attach(label(DONATE_ACCOUNT_NAME, "account-value"), 1, 1, 1, 1)
        account.append(details)

        number_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        number_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        number_box.append(label("Số tài khoản", "account-label"))
        number_box.append(label(DONATE_ACCOUNT_NUMBER, "account-number", selectable=True))
        number_row.append(number_box)
        spacer_box = Gtk.Box()
        spacer_box.set_hexpand(True)
        number_row.append(spacer_box)
        self.copy_button = Gtk.Button(label="Sao chép số tài khoản")
        self.copy_button.add_css_class("ghost")
        self.copy_button.set_valign(Gtk.Align.CENTER)
        self.copy_button.connect("clicked", self._copy_account_number)
        number_row.append(self.copy_button)
        account.append(number_row)
        content.append(account)

        note = label(
            "BaroKey là dự án mã nguồn mở. Mọi đóng góp đều được trân trọng.",
            "donate-note",
            wrap=True,
            xalign=0.5,
            justify_center=True,
        )
        note.set_halign(Gtk.Align.CENTER)
        content.append(note)

        close = Gtk.Button(label="Đóng")
        close.add_css_class("primary")
        close.set_hexpand(True)
        close.connect("clicked", lambda *_: self.close())
        content.append(close)

    def _copy_account_number(self, button: Gtk.Button) -> None:
        display = Gdk.Display.get_default()
        if display is not None:
            provider = Gdk.ContentProvider.new_for_bytes(
                "text/plain;charset=utf-8",
                GLib.Bytes.new(DONATE_ACCOUNT_NUMBER.encode("utf-8")),
            )
            display.get_clipboard().set_content(provider)
        button.set_label("Đã sao chép")
        if self._copy_timer is not None:
            GLib.source_remove(self._copy_timer)
        self._copy_timer = GLib.timeout_add(1600, self._reset_copy_label)

    def _reset_copy_label(self) -> bool:
        self.copy_button.set_label("Sao chép số tài khoản")
        self._copy_timer = None
        return False


class SettingsWindow(Gtk.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app)
        self.add_css_class("barokey")
        self.set_default_size(1024, 720)
        self.set_size_request(960, 640)
        self.set_title(APP_NAME)
        self.set_default_icon_name("barokey")

        self.app = app
        self.config = config.load()
        self._synced = dict(self.config)  # what is on disk as far as we know
        self._loading = True
        self._toast_timer = None
        self._nav_buttons: dict[str, Gtk.Button] = {}
        self._pages: dict[str, Gtk.Widget] = {}
        self._method_cards: dict[str, Gtk.Button] = {}
        self._tone_cards: dict[str, Gtk.Button] = {}
        self._theme_cards: dict[str, Gtk.Button] = {}
        self._style_cards: dict[str, Gtk.Button] = {}
        self._shortcut_caps: dict[str, Gtk.Box] = {}
        self._overview_shortcut_caps: dict[str, Gtk.Box] = {}

        Gtk.Window.set_default_icon_name("barokey")
        self._build_titlebar()
        self._build_layout()
        self._build_state_bindings()
        self._loading = False
        self.apply_style_class()
        self._sync_widgets()
        self.connect("notify::is-active", self._on_active_changed)
        self._show_page("overview")

    def apply_style_class(self) -> None:
        tahoe = self.config.get("ui_style") == "tahoe"
        if tahoe:
            self.add_css_class("tahoe")
        else:
            self.remove_css_class("tahoe")
        # macOS puts close/minimize/maximize on the left as coloured dots.
        self._titlebar.baro_lights.set_visible(tahoe)
        self._titlebar.baro_controls.set_visible(not tahoe)
        self.sidebar_section.set_visible(tahoe)
        self.center_title.set_visible(tahoe)

    # ------------------------------------------------------------- title bar
    def _build_titlebar(self) -> None:
        title = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        logo = logo_image(16)
        logo.set_valign(Gtk.Align.CENTER)
        title.append(logo)
        title.append(label(APP_NAME, "titlebar-name"))
        title.append(label("- Bộ gõ tiếng Việt cho Linux", "titlebar-sub"))
        self._titlebar = make_titlebar(title)
        self.set_titlebar(self._titlebar)

